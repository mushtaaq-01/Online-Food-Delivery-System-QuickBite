# Server Port
PORT=4000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/food-del
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-del
MONGO_URL=mongodb://127.0.0.1:27017/food-del

# JWT Secret Key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Bcrypt salt rounds (standard: 10)
SALT=10

# Stripe Secret Key for payments (from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Frontend URL (for Stripe redirect verification)
FRONTEND_URL=http://localhost:5173

